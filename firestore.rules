rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/accounts/{accountId} {
      allow read, write, delete: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/activity/{eventId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['uid', 'email', 'type', 'method', 'createdAt', 'userAgent'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.type in ['login', 'logout']
        && request.resource.data.method in ['password', 'google', 'unknown']
        && request.resource.data.email is string
        && request.resource.data.createdAt is number
        && request.resource.data.userAgent is string;
      allow update, delete: if false;
    }
    match /users/{userId}/profile/{profileId} {
      allow read, write: if request.auth != null && request.auth.uid == userId && profileId == 'settings';
    }
    match /users/{userId}/meta/{metaId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
